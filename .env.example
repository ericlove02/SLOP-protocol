# Copy to .env and fill in. Never commit .env.
# The encoder (image -> words) needs ONE vision provider:
ANTHROPIC_API_KEY=
# The decoder (words -> image) needs ONE image-generation provider:
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional extras
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
# Any OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter...) for the encoder
SLOP_OPENAI_COMPAT_BASE_URL=
SLOP_OPENAI_COMPAT_API_KEY=
SLOP_OPENAI_COMPAT_MODEL=

# Model overrides (see src/slop/config.py for defaults)
# SLOP_ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
# SLOP_OPENAI_VISION_MODEL=
# SLOP_GEMINI_VISION_MODEL=
# SLOP_OPENAI_IMAGE_MODEL=
# SLOP_GEMINI_IMAGE_MODEL=
